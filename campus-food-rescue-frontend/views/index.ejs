<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#fdfaf2"><meta name="description" content="A student-friendly campus food rescue platform."><title>Campus Food Rescue</title><link rel="stylesheet" href="/assets/css/styles.css"><script defer src="/assets/js/app.js"></script></head>
<body data-page="<%= page %>">
  <% if (!['welcome','signup'].includes(page)) { %><%- include('partials/header') %><% } %>
  <main id="mainContent" class="app-main <%= ['welcome','signup'].includes(page) ? 'auth-main' : '' %>">
  <% if (page === 'welcome') { %>
    <section class="auth-layout"><div class="auth-hero"><div class="hero-plants"><img src="/assets/img/monstera.svg" alt="Illustrated green monstera houseplant"></div><div class="auth-hero-copy"><p class="eyebrow">🌱 WELCOME TO CAMPUS FOOD RESCUE</p><h1>Rescue Food.<br>Reduce Waste.<br><em>Grow Together.</em></h1><p>Delicious extra meals from campus cafés, rescued by students like you. Always free, always a little greener.</p><div class="steps"><span>🥗 Browse free meals</span><span>📅 Reserve a portion</span><span>🌿 Pick it up</span></div></div></div><div class="auth-panel"><a class="brand auth-brand" href="/welcome">🌿 <span>Campus<br>Food Rescue</span></a><span class="floral">✿ <span>✿</span></span><h2>Welcome back <span class="leaf-text">❧</span></h2><p class="muted">Log in to see what's growing on campus.</p><form id="loginForm" class="form-stack"><label>University email<input name="email" type="email" required autocomplete="email" placeholder="you@university.edu"></label><label>Password<input name="password" type="password" required minlength="6" autocomplete="current-password" placeholder="Enter your password"></label><button class="button button-primary button-wide" type="submit">Log In <span>🌿</span></button></form><p class="auth-bottom">New to Campus Food Rescue? <a href="/signup">Sign up as a student →</a></p><p class="demo-note">Demo only: enter any email and a password of at least 6 characters.</p></div></section>
  <% } else if (page === 'signup') { %>
    <section class="auth-layout signup-layout"><div class="auth-hero compact-hero"><img class="signup-plant" src="/assets/img/sansevieria.svg" alt="Illustrated potted snake plant"><div class="auth-hero-copy"><p class="eyebrow">🌿 JOIN OUR CAMPUS COMMUNITY</p><h1>Every meal<br>makes a <em>difference.</em></h1><p>Help your campus waste less food, one delicious rescue at a time.</p><div class="soft-card"><h3>✓ Eligibility guidelines</h3><p>Be an enrolled student, use your university email, and only reserve food you can collect.</p></div></div></div><div class="auth-panel"><a class="brand auth-brand" href="/welcome">🌿 <span>Campus<br>Food Rescue</span></a><h2>Create your account <span class="leaf-text">❧</span></h2><p class="muted">A few details and you're ready to rescue.</p><form id="signupForm" class="form-stack"><label>Full name<input name="name" required autocomplete="name" placeholder="Alex Chen"></label><label>University email<input name="email" required type="email" autocomplete="email" placeholder="alex@university.edu"></label><label>Password<input name="password" required type="password" minlength="6" autocomplete="new-password" placeholder="At least 6 characters"></label><label>Confirm password<input name="confirm" required type="password" minlength="6" autocomplete="new-password" placeholder="Repeat password"></label><label class="check-line"><input type="checkbox" name="agree" required> I agree to collect food I reserve and respect the campus guidelines.</label><button type="submit" class="button button-primary button-wide">Create Account 🌱</button></form><p class="auth-bottom">Already have an account? <a href="/welcome">Log in →</a></p></div></section>
  <% } else if (page === 'browse') { %>
    <section class="welcome-banner"><div><p class="eyebrow">TODAY'S LITTLE ACT OF GOOD</p><h1>Good food, better planet <span class="leaf-text">❧</span></h1><p>Find a free meal near you and give delicious food a second chance.</p></div><img src="/assets/img/monstera.svg" alt="" aria-hidden="true"></section>
    <div class="browse-layout"><aside class="panel filter-panel"><div class="panel-heading"><h2>Find your food</h2><span>🌿</span></div><form id="filtersForm"><label for="searchInput">Search meals</label><input id="searchInput" type="search" placeholder="Pasta, soup, café…"><label for="providerFilter">Provider</label><select id="providerFilter"><option value="">All providers</option></select><fieldset><legend>Avoid allergens</legend><div id="allergenFilters" class="checkbox-grid"></div></fieldset><label for="timeFilter">Pickup time</label><select id="timeFilter"><option value="">Any time</option><option value="before17">Before 5 PM</option><option value="after17">After 5 PM</option></select><label for="distanceFilter">Maximum distance</label><select id="distanceFilter"><option value="">Any distance</option><option value="0.5">Within 0.5 km</option><option value="1">Within 1 km</option><option value="2">Within 2 km</option></select><button class="button button-primary button-wide" type="submit">Apply filters 🌱</button><button class="text-button button-wide" id="clearFilters" type="button">Clear filters</button></form></aside><section class="listings-area"><div class="section-heading"><div><p class="eyebrow">FRESHLY RESCUED</p><h2>Available food <span id="listingCount" class="count"></span></h2></div><span class="section-flower">✿</span></div><div id="listingsGrid" class="listings-grid"></div></section><aside class="sidebar-stack"><div class="panel favorites-panel"><h3>♡ Favorite providers</h3><div id="favoritesList"></div></div><div class="tip-card">🌿 <strong>Little tip</strong><p>Favorite a provider to see its newest food first.</p></div></aside></div>
  <% } else if (page === 'listing') { %>
    <section id="listingDetail"><p class="muted">Loading food details…</p></section>
  <% } else if (page === 'reservations') { %>
    <section class="page-title"><p class="eyebrow">YOUR FOOD JOURNEY</p><h1>My Reservations <span class="leaf-text">❧</span></h1><p>Keep track of the meals you've saved and where to collect them.</p></section><nav class="tabs" id="reservationTabs" aria-label="Reservation status"><button data-status="UPCOMING" class="active">Upcoming</button><button data-status="COLLECTED">Collected</button><button data-status="CANCELLED">Cancelled</button><button data-status="MISSED">Missed</button></nav><section id="reservationList" class="reservation-list"></section><p class="info-strip">ⓘ You can cancel an upcoming reservation before the pickup window ends. In a live system, the provider confirms collections.</p>
  <% } else if (page === 'profile') { %>
    <section class="page-title"><p class="eyebrow">YOUR POSITIVE IMPACT</p><h1>My Profile & Impact <span class="leaf-text">❧</span></h1><p>Every saved meal is a small victory for our campus.</p></section><div class="profile-grid"><section class="panel profile-panel"><div class="profile-info"><div class="avatar">🌻</div><div><h2 id="profileName">Student</h2><p id="profileEmail" class="muted"></p><span class="chip chip-blue">Student</span></div></div><form id="profileForm" class="form-stack"><label>Display name<input id="profileNameInput" required maxlength="70"></label><label>Avatar picture URL (optional)<input id="profileAvatarInput" type="url" placeholder="https://example.com/photo.png"></label><button class="button button-primary" type="submit">Save profile 🌿</button></form></section><section class="impact-panel"><div class="stats-grid"><div class="stat-card"><span>🍽</span><strong id="mealsSaved">0</strong><small>Meals saved</small></div><div class="stat-card blue"><span>☁</span><strong id="co2Saved">0 kg</strong><small>CO₂ avoided (demo estimate)</small></div></div><div class="panel"><h3>♡ My favorite providers</h3><div id="profileFavorites"></div></div><div class="tip-card">🌸 Your little efforts add up. Thank you for making our campus greener!</div></section></div>
  <% } else if (page === 'provider-dashboard') { %>
    <section class="page-title"><p class="eyebrow">FOR CAMPUS FOOD PROVIDERS</p><h1>Provider Dashboard <span class="leaf-text">❧</span></h1><p>Turn today's surplus into someone's favorite meal.</p></section><%- include('partials/provider-nav') %><div class="stats-grid four" id="providerStats"></div><div class="dashboard-layout"><section class="panel"><div class="panel-heading"><h2>Latest listings</h2><a href="/provider-listings">See all →</a></div><div id="providerLatest"></div></section><aside class="action-stack"><a class="action-card" href="/provider-editor"><span>✿</span><strong>Create a listing</strong><small>Share food with students →</small></a><a class="action-card" href="/provider-pickups"><span>📋</span><strong>Manage pickups</strong><small>Mark food as collected →</small></a><a class="action-card" href="/provider-settings"><span>🌿</span><strong>Shop settings</strong><small>Change your pickup window →</small></a></aside></div>
  <% } else if (page === 'provider-listings') { %>
    <section class="page-title"><p class="eyebrow">MANAGE YOUR SURPLUS</p><h1>My Food Listings <span class="leaf-text">❧</span></h1><p>Publish, edit and track your available food.</p></section><%- include('partials/provider-nav') %><div class="toolbar"><span id="providerListingsCount"></span><a href="/provider-editor" class="button button-primary">+ Create a listing 🌿</a></div><div id="providerListingTable" class="provider-list"></div>
  <% } else if (page === 'provider-editor') { %>
    <section class="page-title"><p class="eyebrow">SHARE WHAT'S LEFT</p><h1 id="editorTitle">Create a Food Listing <span class="leaf-text">❧</span></h1><p>Provide clear details so students know what they're reserving.</p></section><%- include('partials/provider-nav') %><form id="listingEditorForm" class="panel editor-form"><div class="form-grid"><label>Food name *<input name="name" required maxlength="100" placeholder="Vegetable pasta bake"></label><label>Number of portions *<input name="portions" type="number" min="0" max="10000" required value="10"></label></div><label>Description<textarea name="description" rows="3" maxlength="500" placeholder="What's in it? How is it prepared?"></textarea></label><fieldset><legend>Allergens * (required for food safety)</legend><p class="muted small">Select every allergen present, or select “No listed allergens.”</p><div id="editorAllergens" class="checkbox-grid many"></div></fieldset><label>Food image URL (optional)<input name="image" type="url" placeholder="https://example.com/food.jpg"></label><div class="form-grid"><label>Pickup start<input name="pickupStart" type="time" required value="16:00"></label><label>Pickup end<input name="pickupEnd" type="time" required value="18:00"></label></div><label class="check-line"><input type="checkbox" name="visible" checked> Visible to students (uncheck to save as draft)</label><div class="form-actions"><button type="submit" class="button button-primary">Save listing 🌱</button><a href="/provider-listings" class="button button-light">Cancel</a></div></form>
  <% } else if (page === 'provider-settings') { %>
    <section class="page-title"><p class="eyebrow">YOUR SHOP'S DETAILS</p><h1>Provider Settings <span class="leaf-text">❧</span></h1><p>Help students find you when it's time to collect their food.</p></section><%- include('partials/provider-nav') %><form id="settingsForm" class="panel editor-form"><label>Shop name<input name="name" required maxlength="100"></label><label>Pickup location<input name="location" required maxlength="140"></label><div class="form-grid"><label>Default pickup start<input type="time" name="pickupStart" required></label><label>Default pickup end<input type="time" name="pickupEnd" required></label></div><div class="form-grid"><label>Contact email<input type="email" name="email" required></label><label>Contact phone<input type="tel" name="phone"></label></div><label>Maximum pickups per student per day (0 = unlimited)<input type="number" min="0" max="100" name="limit" required></label><button type="submit" class="button button-primary">Save settings 🌿</button></form>
  <% } else if (page === 'provider-pickups') { %>
    <section class="page-title"><p class="eyebrow">EVERY RESCUED MEAL COUNTS</p><h1>Manage Pickups <span class="leaf-text">❧</span></h1><p>See student reservations and record successful collections.</p></section><%- include('partials/provider-nav') %><section class="panel"><div class="panel-heading"><h2>Reservations to manage</h2><span class="muted">Demo preview</span></div><div id="pickupList"></div></section>
  <% } else if (page === 'admin') { %>
    <section class="page-title"><p class="eyebrow">KEEP OUR COMMUNITY SAFE</p><h1>Maintainer Dashboard <span class="leaf-text">❧</span></h1><p>Review new campus providers and follow up on reported issues.</p></section><div class="stats-grid three" id="adminStats"></div><div class="dashboard-layout admin-layout"><section class="panel"><h2>Pending provider requests 🌿</h2><div id="providerRequests"></div></section><section class="panel"><h2>Issue reports ✿</h2><div id="issueReports"></div></section></div>
  <% } else if (page === 'report') { %>
    <section class="page-title"><p class="eyebrow">HELP US GROW</p><h1>Report an Issue <span class="leaf-text">❧</span></h1><p>Tell the maintainers about something that isn't working.</p></section><form id="reportForm" class="panel editor-form"><label>What happened?<select name="category" required><option value="Bug">A bug in the app</option><option value="Food listing">Problem with a food listing</option><option value="Provider">Provider concern</option><option value="Other">Other</option></select></label><label>Description<textarea name="description" required minlength="10" rows="6" maxlength="2000" placeholder="Describe the problem…"></textarea></label><label>Optional screenshot URL<input type="url" name="image" placeholder="https://example.com/screenshot.png"></label><button type="submit" class="button button-primary">Send report 🌸</button></form>
  <% } else { %><section class="empty-state"><h1>Page not found</h1><p>Maybe this page is still growing?</p><a class="button button-primary" href="/browse">Back to meals</a></section><% } %>
  </main>
  <% if (!['welcome','signup'].includes(page)) { %><%- include('partials/footer') %><% } else { %><div id="toast" class="toast" role="status" aria-live="polite"></div><% } %>
</body></html>
